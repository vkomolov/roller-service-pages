{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler", // could be "Node",
        "esModuleInterop": true,

        "allowJs": true,
        "checkJs": true,

        "strict": true,
        "noImplicitAny": true,

        "typeRoots": ["./types", "./node_modules/@types"],

        //"baseUrl": ".",
        //with bundlers, using alias
        /*        "paths": {
            "@*//*": ["src*//*"]
        }*/
    },
    "exclude": [
        //for most cases...
        "node_modules",
        "dist",
        "build",
        "public"
    ]
}